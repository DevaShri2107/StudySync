rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        getUserData().role == 'Administrator' ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }

    function isFaculty() {
      return isAuthenticated() && (
        getUserData().role == 'faculty' ||
        getUserData().role == 'Faculty'
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        getUserData().role == 'student' ||
        getUserData().role == 'Student'
      );
    }

    function getStudentProfile() {
      return get(/databases/$(database)/documents/Students/$(request.auth.uid)).data;
    }

    match /Users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /Students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == studentId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == studentId || isAdmin() || isFaculty());
      allow delete: if isAdmin();
    }

    match /Faculty/{facultyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == facultyId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == facultyId || isAdmin());
      allow delete: if isAdmin();
    }

    match /Departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /Years/{yearId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /Sections/{sectionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /Subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isFaculty();
    }

    match /Attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );
      allow create, update: if isAuthenticated() && (isAdmin() || isFaculty());
      allow delete: if isAdmin();
    }

    match /Assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        (isStudent() &&
          resource.data.departmentId == getStudentProfile().departmentId &&
          resource.data.yearId == getStudentProfile().yearId &&
          resource.data.sectionId == getStudentProfile().sectionId)
      );
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isFaculty());
    }

    match /AssignmentSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );
      allow create: if isAuthenticated() && isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /Notes/{noteId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        (isStudent() &&
          resource.data.departmentId == getStudentProfile().departmentId &&
          resource.data.yearId == getStudentProfile().yearId &&
          resource.data.sectionId == getStudentProfile().sectionId)
      );
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isFaculty());
    }

    match /StudyPlanner/{taskId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.studentId == request.auth.uid || isAdmin()
      );
    }

    match /StudySessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        (isStudent() &&
          resource.data.departmentId == getStudentProfile().departmentId &&
          resource.data.yearId == getStudentProfile().yearId &&
          resource.data.sectionId == getStudentProfile().sectionId)
      );
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isFaculty());
    }

    match /Announcements/{announcementId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        (isStudent() &&
          resource.data.departmentId == getStudentProfile().departmentId &&
          resource.data.yearId == getStudentProfile().yearId &&
          resource.data.sectionId == getStudentProfile().sectionId)
      );
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isFaculty());
    }

    match /Notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == 'all'
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /Reports/{reportId} {
      allow read: if isAuthenticated() && (isAdmin() || isFaculty());
      allow write: if isAdmin();
    }
    match /Settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /GoogleIntegrations/{integrationId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == integrationId || isAdmin());
    }
  }
}
